# .gitignore

# Node.js
node_modules/
npm-debug.log
.env
*.env
.DS_Store # macOS specific
.vscode/ # VS Code specific settings
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js

# Coverage directories
coverage/
.nyc_output/

# Logs
logs
*.log
npm-debug.log*

# Database
*.sqlite
*.db

# OS generated files
.DS_Store
.Trashes
ehthumbs.db
Thumbs.db

# Editor directories and files
.idea/
.project
.classpath
.c9/
*.swp
*.bak
*.swo

# Docker
*.pem # Generated Docker certs often end with .pem
*.crt
*.key
!Dockerfile* # Don't ignore Dockerfile itself if it's in a service dir, but ignore certs

# For each service in the 'services/' directory
# These patterns will apply to all subdirectories automatically
# if the services are built as standard Node.js projects.
node_modules/
.env
.log
npm-debug.log*
coverage/
dbSchema.sql